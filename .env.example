# SENTRA-FS Security & Runtime Configuration
# Copy this template to .env and configure your secret.
# Never commit the active .env file into source control.

SENTRA_JWT_SECRET=replace-with-a-long-random-secret
SENTRA_JWT_ALGORITHM=HS256
SENTRA_JWT_EXPIRE_HOURS=8
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173